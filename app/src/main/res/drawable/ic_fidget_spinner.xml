            android:pathData="M 38,20 L 62,20 L 62,50 L 38,50 Z" />
        <!-- Outer Pod Circle -->
        <path
            android:fillColor="#FFB59F"
            android:pathData="M 50,4 A 16,16 0 1,1 50,36 A 16,16 0 1,1 50,4 Z" />
