        <path
            android:fillColor="#332D2B"
            android:pathData="M 50,9 A 11,11 0 1,1 50,31 A 11,11 0 1,1 50,9 Z" />
        <!-- Bearing Ball / Inner Cap -->
        <path
            android:fillColor="#52525B"
            android:pathData="M 50,13 A 7,7 0 1,1 50,27 A 7,7 0 1,1 50,13 Z" />
        <path
            android:fillColor="#1C1C1E"
            android:pathData="M 50,17 A 3,3 0 1,1 50,23 A 3,3 0 1,1 50,17 Z" />
    </group>

    <!-- Lobe 2 (Bottom Right - 120 degrees) -->
    <group android:pivotX="50" android:pivotY="50" android:rotation="120">
