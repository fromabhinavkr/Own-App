<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Starfield Background (Bottom Layer) -->
    <com.abhinav.ownapp.StarfieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Interactive Globe (Middle Layer) -->
    <com.abhinav.ownapp.GlobeGLSurfaceView
        android:id="@+id/globe_view_game"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true" />

    <!-- 3. UFO Game Logic and Spawner (Top Layer) -->
    <com.abhinav.ownapp.UfoGameOverlayView
        android:id="@+id/ufo_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 4. Top UI Bar - Hidden initially for Scenery Mode! -->
    <LinearLayout
        android:id="@+id/top_ui_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Score Pill (Left) perfectly locked to the start -->
            <LinearLayout
                android:id="@+id/btnScore"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="20dp"
                android:paddingStart="6dp">

                <FrameLayout
                    android:id="@+id/scoreIconContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/tvScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Score: 0"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lives Pill (Right) perfectly locked to the end -->
            <LinearLayout
                android:id="@+id/btnLives"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="20dp"
                android:paddingStart="6dp">

                <FrameLayout
                    android:id="@+id/livesIconContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/tvLivesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Lives: 3"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>