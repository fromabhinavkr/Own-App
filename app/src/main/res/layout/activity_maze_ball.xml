<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMazeBall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The Retro Game Canvas -->
    <FrameLayout
        android:id="@+id/gameCanvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Modern HUD: Quick Settings Style Pills -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        android:clipToPadding="false">

        <!-- Left HUD Pill (Lives) -->
        <LinearLayout
            android:id="@+id/hudLivesPill"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="20dp"
            android:paddingStart="6dp">

            <!-- Inner Colored Square Box for Icon -->
            <FrameLayout
                android:id="@+id/livesIconBox"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <!-- Text -->
            <TextView
                android:id="@+id/tvLivesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Lives: 3"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right HUD Pill (Rings & Best) -->
        <LinearLayout
            android:id="@+id/hudRingsPill"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="20dp"
            android:paddingStart="6dp">

            <!-- Inner Colored Square Box for Icon -->
            <FrameLayout
                android:id="@+id/ringsIconBox"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rings: 0000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBestText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best: 0000"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom UI: Modern Floating Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="◀"
                android:textSize="24sp"
                android:layout_marginEnd="16dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="▶"
                android:textSize="24sp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <Button
            android:id="@+id/btnJump"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="▲"
            android:textSize="28sp"
            android:elevation="4dp"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <!-- MODERN MODE SELECTION OVERLAY -->
    <RelativeLayout
        android:id="@+id/modeSelectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/modeSelectionCard"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:elevation="12dp">

            <TextView
                android:id="@+id/tvModeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Mode"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnModeLandscape"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Classic Runner"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnModePortrait"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Tower Climber"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- MODERN GAME OVER OVERLAY -->
    <RelativeLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:gravity="center"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/gameOverCard"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:elevation="12dp">

            <TextView
                android:id="@+id/tvGameOverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Over"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnPlayAgain"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Play Again"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnQuit"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Quit"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>