<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- 1. DYNAMIC CENTERED PILL-IN-PILL HEADER -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp">

        <!-- Outer Capsule (ZERO SHADOWS) -->
        <LinearLayout
            android:id="@+id/top_capsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/modern_button"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:elevation="0dp">

            <!-- Inner Circle Pill for Mode Button -->
            <FrameLayout
                android:id="@+id/theme_toggle_pill"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:elevation="0dp">

                <ImageButton
                    android:id="@+id/btn_app_theme_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_moon"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:contentDescription="@string/theme_toggle_desc" />
            </FrameLayout>

            <!-- Stacked Container for Time and Date -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center">

                <!-- Inner Pill for Time -->
                <LinearLayout
                    android:id="@+id/time_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:gravity="center"
                    android:elevation="0dp">

                    <TextClock
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm a"
                        android:format24Hour="HH:mm"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Inner Pill for Date (Clickable for Calendar) -->
                <LinearLayout
                    android:id="@+id/date_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:elevation="0dp">

                    <TextClock
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEE, MMM dd"
                        android:format24Hour="EEE, MMM dd"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Device Stats Dashboard (Adaptive Height) -->
    <LinearLayout
        android:id="@+id/dashboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:gravity="top"
        android:orientation="vertical">

        <include layout="@layout/layout_device_dashboard" />

    </LinearLayout>

    <!-- 3. The 2x2 Grid Layout (Adaptive Scroll & Resize) -->
    <ScrollView
        android:id="@+id/grid_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dashboard_container"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="16dp"
        android:fillViewport="true">

        <!-- Grid Directly inside ScrollView for perfect height matching -->
        <GridLayout
            android:id="@+id/tabsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins">

            <!-- CARD 1: Widgets -->
            <!-- PERFECT FLEX LAYOUT: Height 0dp, Row/Column Weights = 1 -->
            <LinearLayout
                android:id="@+id/btnPlaceWidget"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:orientation="vertical"
                android:background="@drawable/modern_button"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center">

                <!-- Image takes remaining space dynamically -->
                <ImageView
                    android:id="@+id/ivWidgetIcon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/icon_main_widgets" />

                <!-- Text stays anchored to the bottom -->
                <TextView
                    android:id="@+id/tvWidgetText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Widgets"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="17sp" />
                <TextView
                    android:id="@+id/tvWidgetSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customize your home"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="12sp" />
            </LinearLayout>

            <!-- CARD 2: Games -->
            <LinearLayout
                android:id="@+id/btnGames"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:orientation="vertical"
                android:background="@drawable/modern_button"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center"
                android:transitionName="shared_games_container">

                <ImageView
                    android:id="@+id/ivGamesIcon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/icon_main_games" />

                <TextView
                    android:id="@+id/tvGamesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Games"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="17sp" />
                <TextView
                    android:id="@+id/tvGamesSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play and enjoy"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="12sp" />
            </LinearLayout>

            <!-- CARD 3: Tools -->
            <LinearLayout
                android:id="@+id/btnTools"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:orientation="vertical"
                android:background="@drawable/modern_button"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivToolsIcon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/icon_main_tools" />

                <TextView
                    android:id="@+id/tvToolsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tools"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="17sp" />
                <TextView
                    android:id="@+id/tvToolsSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Handy tools for you"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="12sp" />
            </LinearLayout>

            <!-- CARD 4: Utilities -->
            <LinearLayout
                android:id="@+id/btnUtilities"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:orientation="vertical"
                android:background="@drawable/modern_button"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivUtilitiesIcon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/icon_main_utilities" />

                <TextView
                    android:id="@+id/tvUtilitiesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Utilities"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="17sp" />
                <TextView
                    android:id="@+id/tvUtilitiesSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Essential utilities"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="12sp" />
            </LinearLayout>

        </GridLayout>
    </ScrollView>
</RelativeLayout>