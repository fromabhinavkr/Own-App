<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flappyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The Game Engine Canvas will be injected here -->
    <FrameLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD: Unified Smart Pill -->
    <RelativeLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <!-- Unified Smart Pill: Pause Icon + Score Text -->
        <LinearLayout
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="20dp"
            android:paddingStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Inner Colored Square Box for Pause/Play Icon -->
            <FrameLayout
                android:id="@+id/pauseIconContainer"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <!-- Vertical Layout for Score & Best Score -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCurrentScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHighScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best: 0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Pause Overlay (Wrapped in ScrollView for Landscape Support) -->
    <RelativeLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="10dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="28dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/pauseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="44dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/tvPauseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAUSED"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnResume"
                    style="@style/ModernButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:backgroundTint="#34C759"
                    android:textColor="#FFFFFF"
                    android:text="Resume Game" />

                <!-- Toggle Vibration Button -->
                <Button
                    android:id="@+id/btnToggleVibration"
                    style="@style/ModernButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:backgroundTint="#8E8E93"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"
                    android:text="Vibration: ON" />

                <Button
                    android:id="@+id/btnQuitFromPause"
                    style="@style/ModernButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:backgroundTint="#FF3B30"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"
                    android:text="Exit Game" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <!-- Game Over Overlay (Wrapped in ScrollView for Landscape Support) -->
    <RelativeLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="10dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="28dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/gameOverCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="44dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:clipToPadding="false">

                <!-- Death Snapshot Container (Shows Proof of Hit) -->
                <FrameLayout
                    android:id="@+id/snapshotContainer"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:elevation="2dp">

                    <ImageView
                        android:id="@+id/ivDeathSnapshot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Death Snapshot" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvGameOverTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GAME OVER"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Dedicated High Score Banner -->
                <TextView
                    android:id="@+id/tvNewHighScoreBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 NEW HIGH SCORE! 🏆"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvFinalScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textSize="22sp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnRestart"
                    style="@style/ModernButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:backgroundTint="#4A90E2"
                    android:textColor="#FFFFFF"
                    android:text="Play Again" />

                <Button
                    android:id="@+id/btnQuit"
                    style="@style/ModernButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp"
                    android:text="Quit" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <!-- Tap to Start Hint -->
    <TextView
        android:id="@+id/tvTapToStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Tap to Fly"
        android:textSize="24sp"
        android:textStyle="bold"
        android:elevation="2dp" />

</RelativeLayout>