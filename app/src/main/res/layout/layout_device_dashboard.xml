<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- TOP SECTION: LIVE RAM MONITOR CARD -->
    <RelativeLayout
        android:id="@+id/ramCardBg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_ram_card"
        android:clipToOutline="true">

        <com.abhinav.ownapp.RamGraphView
            android:id="@+id/ramGraphView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp" />

        <!-- TOP LEFT: RAM Icon and Total Text Stack -->
        <LinearLayout
            android:id="@+id/ramHeaderLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_blue"
                android:backgroundTint="#4842FF"
                android:src="@drawable/ic_ram"
                android:padding="5dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvRamTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating..."
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- TOP RIGHT: Used and Free RAM Stack -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/ramHeaderLeft"
            android:layout_alignBottom="@id/ramHeaderLeft"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/tvRamUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvRamFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- BOTTOM SECTION: STORAGE & BATTERY UNIFIED CARD -->
    <LinearLayout
        android:id="@+id/storageBatteryCardBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="12dp"
        android:background="@drawable/bg_storage_card"
        android:clipToOutline="true"
        android:weightSum="2">

        <!-- STORAGE STATS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_blue"
                android:backgroundTint="#4842FF"
                android:src="@drawable/ic_storage"
                android:padding="8dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStorageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- COMPACT CAPSULE DESIGN: Fixed width of 110dp -->
                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp">

                    <ProgressBar
                        android:id="@+id/pbStorage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvStorageValue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Calc..."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeMaxTextSize="12sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BATTERY STATS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_blue"
                android:backgroundTint="#4842FF"
                android:src="@drawable/ic_battery"
                android:padding="8dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBatteryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- COMPACT CAPSULE DESIGN: Fixed width of 110dp -->
                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp">

                    <ProgressBar
                        android:id="@+id/pbBattery"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"/>

                    <TextView
                        android:id="@+id/tvBatteryValue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Check..."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeMaxTextSize="12sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>